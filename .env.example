# Postgres connection string (Vercel Postgres in prod, local Postgres in dev)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/fishing

# Secret used to sign session cookies (min 16 chars; rotate to force re-login)
SESSION_SECRET=please-change-me-to-a-long-random-string

# Note: accounts are now per-user (username + password). The first account
# created adopts any catches from the old single-password version.
